generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Course {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  category     String
  shortDesc    String   @db.Text
  overview     String   @db.Text
  eligibility  String
  duration     String
  careers      String   @db.Text
  icon         String
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FacultyMember {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  designation    String
  qualifications String
  bio            String?  @db.Text
  image          String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GalleryImage {
  id           String   @id @default(cuid())
  title        String
  imageUrl     String
  altText      String
  category     String   @default("image")
  cloudinaryId String?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Application {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  course    String
  message   String?  @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  course      String
  quote       String   @db.Text
  rating      Int      @default(5)
  featured    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  section   String   @unique
  title     String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  createdAt DateTime @default(now())
}
